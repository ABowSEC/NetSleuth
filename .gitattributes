# Normalize all text files to LF in the repo and on checkout
* text=auto eol=lf

# Explicitly binary never touch line endings
*.pkl   binary
*.csv   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pcap  binary
*.db    binary

# Windows batch files must keep CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
